{
  "name": "travelx",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go",
    "start:clear": "expo start --go --clear",
    "web": "expo start --web",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,js,ts}\" README.md",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{json,js,ts}\" README.md",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "doctor": "npx --yes expo-doctor",
    "backend:prepare": "node scripts/build-backend.mjs",
    "backend:test": "node scripts/test-backend.mjs"
  },
  "private": true
}
